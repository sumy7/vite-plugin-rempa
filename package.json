{
  "name": "vite-plugin-rempa",
  "type": "module",
  "version": "0.1.0",
  "description": "Generate React and Vue multi-page applications from page configs with Vite.",
  "author": "SumyGG Sun <sumyggsun@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sumy7/vite-plugin-rempa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumy7/vite-plugin-rempa.git"
  },
  "bugs": {
    "url": "https://github.com/sumy7/vite-plugin-rempa/issues"
  },
  "keywords": [
    "vite",
    "react",
    "vue",
    "plugin",
    "mpa",
    "vite-plugin"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsdown --watch --ignore-watch examples",
    "build": "tsdown",
    "build:example": "tsdown && vite build examples/react",
    "play": "vite examples/react",
    "preview": "vite preview examples/react",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "tsdown",
    "prepublishOnly": "tsdown",
    "release": "bumpp && npm publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsdown && vitest run --config vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project examples/react/tsconfig.json && vue-tsc --noEmit --project examples/vue/tsconfig.json",
    "play:vue": "vite examples/vue",
    "build:example:vue": "tsdown && vite build examples/vue",
    "preview:vue": "vite preview examples/vue"
  },
  "peerDependencies": {
    "vite": "^8.3.6"
  },
  "dependencies": {
    "ejs": "^7.0.2",
    "glob": "^14.0.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "volta": {
    "node": "24.12.0"
  }
}
